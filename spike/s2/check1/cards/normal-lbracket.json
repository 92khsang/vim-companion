{
  "card": "normal [\"[\"]",
  "title": "normal after [",
  "keys": ["["],
  "rows": [
    {
      "key": "'",
      "sets": ["defaults", "extensions"],
      "setup": ["k", "m", "b", "j"],
      "source": "vim-oracle",
      "reason": "state: mark or jump; [' reads the mark or jump",
      "label": "Move to the first non-blank of the previous line with a lowercase mark",
      "labelFrom": "hand",
      "labelIndex": "index.txt L642 |['|",
      "expect": {
        "text": "unchanged",
        "cursor": [0, 0],
        "mode": "normal"
      },
      "oracle": {
        "vimrc": "expect-sw2.vimrc",
        "layout": "single"
      },
      "handBasis": {
        "expectFrom": "VSCodeVim 1.32.4 src/actions/motion.ts L649-662 (PrevMarkLinewise); setup k mb j puts mark b on line 0, the only line above the cursor, so earlier marks cannot change the answer"
      }
    },
    {
      "key": "(",
      "sets": ["defaults", "extensions"],
      "source": "vim-oracle",
      "label": "Move N times back to unmatched '('",
