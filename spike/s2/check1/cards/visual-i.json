      "expect": {
        "text": "unchanged",
        "cursor": {
          "vim": [1, 14],
          "visualStart": [1, 12],
          "docLines": 5
        },
        "mode": "visual"
      },
      "oracle": {
        "vimrc": "expect-sw2.vimrc",
