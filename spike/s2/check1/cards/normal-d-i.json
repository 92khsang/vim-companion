        },
        "cursor": [1, 12],
        "mode": "normal",
        "registers": {
          "\"": {
            "mode": "character",
            "lines": ["two"]
          },
          "-": {
            "mode": "character",
            "lines": ["two"]
          }
        }
      }
    },
