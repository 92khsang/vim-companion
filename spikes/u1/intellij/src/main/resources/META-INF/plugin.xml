<idea-plugin>
  <id>spike.u1</id>
  <name>U1 UI Gallery</name>
  <vendor>vim-companion spike</vendor>
  <description>Throwaway U1 Swing design gallery. No key handling or engine integration.</description>
  <depends>com.intellij.modules.platform</depends>
  <extensions defaultExtensionNs="com.intellij">
    <postStartupActivity implementation="spike.u1.GalleryStartup"/>
  </extensions>
  <actions>
    <action id="spike.u1.gallery" class="spike.u1.GalleryAction" text="UI Gallery"/>
  </actions>
</idea-plugin>
