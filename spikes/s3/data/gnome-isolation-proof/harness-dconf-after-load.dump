[org/freedesktop/ibus/engine/hangul]
auto-reorder=false
hangul-keyboard='2'
initial-input-mode='latin'
off-keys='Escape'
switch-keys='Shift+space'
word-commit=false

[org/gnome/desktop/input-sources]
mru-sources=[('ibus', 'hangul'), ('xkb', 'us')]
per-window=false
sources=[('ibus', 'hangul'), ('xkb', 'us')]
xkb-options=['grp:shift_space_toggle', 'caps:ralt', 'caps:none']

[org/gnome/desktop/notifications]
show-banners=false

[org/gnome/desktop/screensaver]
idle-activation-enabled=false
lock-enabled=false

[org/gnome/desktop/session]
idle-delay=uint32 0

[org/gnome/shell]
disable-user-extensions=false
enabled-extensions=['s3-harness@vimcompanion.spike']
