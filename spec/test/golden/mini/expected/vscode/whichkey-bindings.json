[
  {
    "key": " ",
    "name": "Find file",
    "type": "command",
    "command": "workbench.action.quickOpen"
  },
  {
    "key": "/",
    "name": "Search in project",
    "type": "command",
    "command": "workbench.action.findInFiles"
  },
  {
    "key": "c",
    "name": "Toggle line comment",
    "type": "command",
    "command": "vim.remap",
    "args": {
      "after": [
        "g",
        "c",
        "c"
      ]
    }
  },
  {
    "key": "f",
    "name": "File",
    "type": "bindings",
    "bindings": [
      {
        "key": "f",
        "name": "Find file",
        "type": "command",
        "command": "workbench.action.quickOpen"
      },
      {
        "key": "o",
        "name": "List symbols in file",
        "type": "command",
        "command": "workbench.action.quickOpen",
        "args": "@"
      },
      {
        "key": "s",
        "name": "Moved to SPC /",
        "type": "command",
        "command": "workbench.action.findInFiles"
      }
    ]
  },
  {
    "key": "w",
    "name": "Window",
    "type": "bindings",
    "bindings": [
      {
        "key": "=",
        "name": "Equalize split sizes",
        "type": "command",
        "command": "workbench.action.evenEditorWidths"
      },
      {
        "key": "h",
        "name": "Focus split left",
        "type": "command",
        "command": "workbench.action.focusLeftGroup"
      },
      {
        "key": "o",
        "name": "Close other splits",
        "type": "command",
        "command": "vim.remap",
        "args": {
          "after": [
            "<C-w>",
            "o"
          ]
        }
      }
    ]
  }
]
