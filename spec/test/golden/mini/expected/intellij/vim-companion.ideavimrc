" vim-companion.ideavimrc: generated by `pnpm gen` from spec/catalog. Do not edit.
" Source it from the last line of ~/.ideavimrc:
"   source ~/.config/vim-companion/vim-companion.ideavimrc
" Restart the IDE after changing it; Reload keeps the old g: variables and Ctrl-key handlers.

if !exists('g:mapleader')
  let g:mapleader = ' '
endif

let g:vimcompanion_skipped = []

let g:WhichKeyDesc_vimcompanion_group_l66 = '<leader>f File'
let g:WhichKeyDesc_vimcompanion_group_l77 = '<leader>w Window'

" file.find
if empty(mapcheck('<leader><Space>', 'n'))
  nmap <leader><Space> <Action>(GotoFile)
  let g:WhichKeyDesc_vimcompanion_file_find_l20 = '<leader><Space> Find file'
else
  call add(g:vimcompanion_skipped, 'n <leader><Space> file.find')
endif

" search.project
if empty(mapcheck('<leader>/', 'n'))
  nmap <leader>/ <Action>(FindInPath)
  let g:WhichKeyDesc_vimcompanion_search_project_l2f = '<leader>/ Search in project'
else
  call add(g:vimcompanion_skipped, 'n <leader>/ search.project')
endif
if empty(mapcheck('<leader>/', 'x'))
  xmap <leader>/ <Action>(FindInPath)
else
  call add(g:vimcompanion_skipped, 'x <leader>/ search.project')
endif

" code.comment
if empty(mapcheck('<leader>c', 'n'))
  nmap <leader>c gcc
  let g:WhichKeyDesc_vimcompanion_code_comment_l63 = '<leader>c Toggle line comment'
else
  call add(g:vimcompanion_skipped, 'n <leader>c code.comment')
endif

" file.find
if empty(mapcheck('<leader>ff', 'n'))
  nmap <leader>ff <Action>(GotoFile)
  let g:WhichKeyDesc_vimcompanion_file_find_l6666 = '<leader>ff Find file'
else
  call add(g:vimcompanion_skipped, 'n <leader>ff file.find')
endif

" file.locations
if empty(mapcheck('<leader>fl', 'n'))
  nmap <leader>fl <Action>(RecentLocations)
  let g:WhichKeyDesc_vimcompanion_file_locations_l666c = '<leader>fl Show recent locations'
else
  call add(g:vimcompanion_skipped, 'n <leader>fl file.locations')
endif

" nav.symbols
if empty(mapcheck('<leader>fo', 'n'))
  nmap <leader>fo <Action>(FileStructurePopup)
  let g:WhichKeyDesc_vimcompanion_nav_symbols_l666f = '<leader>fo List symbols in file'
else
  call add(g:vimcompanion_skipped, 'n <leader>fo nav.symbols')
endif
if empty(mapcheck('<leader>fo', 'x'))
  xmap <leader>fo <Action>(FileStructurePopup)
else
  call add(g:vimcompanion_skipped, 'x <leader>fo nav.symbols')
endif

" search.project
if empty(mapcheck('<leader>fs', 'n'))
  nmap <leader>fs <Action>(FindInPath)
  let g:WhichKeyDesc_vimcompanion_search_project_l6673 = '<leader>fs Moved to SPC /'
else
  call add(g:vimcompanion_skipped, 'n <leader>fs search.project')
endif
if empty(mapcheck('<leader>fs', 'x'))
  xmap <leader>fs <Action>(FindInPath)
else
  call add(g:vimcompanion_skipped, 'x <leader>fs search.project')
endif

" window.equalize: unsupported in IntelliJ: No IntelliJ action gives all splits the same size.

" window.focus-left
if empty(mapcheck('<leader>wh', 'n'))
  nnoremap <leader>wh <C-w>h
  let g:WhichKeyDesc_vimcompanion_window_focus_left_l7768 = '<leader>wh Focus split left'
else
  call add(g:vimcompanion_skipped, 'n <leader>wh window.focus-left')
endif

" window.only
if empty(mapcheck('<leader>wo', 'n'))
  nmap <leader>wo <Action>(UnsplitAll)
  let g:WhichKeyDesc_vimcompanion_window_only_l776f = '<leader>wo Close other splits'
else
  call add(g:vimcompanion_skipped, 'n <leader>wo window.only')
endif

" edit.yank-eol
if empty(mapcheck('Y', 'n'))
  nnoremap Y y$
  let g:WhichKeyDesc_vimcompanion_edit_yank_eol_v59 = 'Y Yank to end of line'
else
  call add(g:vimcompanion_skipped, 'n Y edit.yank-eol')
endif

" diag.next
if empty(mapcheck(']d', 'n'))
  nmap ]d <Action>(GotoNextError)
  let g:WhichKeyDesc_vimcompanion_diag_next_v5d64 = ']d Go to next problem'
else
  call add(g:vimcompanion_skipped, 'n ]d diag.next')
endif

" nav.symbols
if empty(mapcheck('gO', 'n'))
  nmap gO <Action>(FileStructurePopup)
  let g:WhichKeyDesc_vimcompanion_nav_symbols_v674f = 'gO List symbols in file'
else
  call add(g:vimcompanion_skipped, 'n gO nav.symbols')
endif
if empty(mapcheck('gO', 'x'))
  xmap gO <Action>(FileStructurePopup)
else
  call add(g:vimcompanion_skipped, 'x gO nav.symbols')
endif

" diag.next
if empty(mapcheck(']e', 'n'))
  nmap ]e <Action>(GotoNextError)
  let g:WhichKeyDesc_vimcompanion_diag_next_v5d65 = ']e Moved to ]d'
else
  call add(g:vimcompanion_skipped, 'n ]e diag.next')
endif

" Ctrl keys: which of the IDE and IdeaVim handles each key; modes left out go to IdeaVim.
sethandler <C-a> a:vim
if has('mac')
  sethandler <C-c> a:vim
else
  sethandler <C-c> a:vim x:ide
endif
