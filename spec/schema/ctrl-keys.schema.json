{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vim-companion Ctrl key handlers",
  "description": "IdeaVim sethandler arguments for each Ctrl key; mac replaces handler on macOS.",
  "type": "object",
  "required": ["keys"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "keys": { "type": "array", "items": { "$ref": "#/$defs/ctrlKey" } }
  },
  "$defs": {
    "ctrlKey": {
      "type": "object",
      "required": ["key", "handler"],
      "additionalProperties": false,
      "properties": {
        "key": { "type": "string" },
        "handler": { "type": "string" },
        "mac": { "type": "string" }
      }
    }
  }
}
