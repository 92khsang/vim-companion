{
  "$schema": "../../schema/fixture-grammar.schema.json",
  "description": "States with nothing pending: after <Esc> cancels a command, after a completed command, and in Insert mode.",
  "start": {
    "lines": [
      "alpha beta gamma delta",
      "  if (one, \"two\", [three]) { four(five) }",
      "epsilon zeta eta theta",
      "iota kappa lambda mu"
    ],
    "cursor": { "line": 1, "column": 13 }
  },
  "cases": [
    {
      "id": "escape-cancels-operator",
      "description": "<Esc> cancels a pending operator and leaves Normal mode with nothing pending.",
      "help": ["mode-switching", "d"],
      "steps": [
        {
          "key": "d",
          "expect": {
            "mode": "normal",
            "pending": ["d"],
            "operator": "d",
            "count": null,
            "register": null
          }
        },
        {
          "key": "<Esc>",
          "expect": {
            "mode": "normal",
            "pending": [],
            "operator": null,
            "count": null,
            "register": null
          }
        }
      ]
    },
    {
      "id": "completed-command",
      "description": "dw deletes a word; after the motion nothing is pending.",
      "help": ["d", "w"],
      "steps": [
        {
          "key": "d",
          "expect": {
            "mode": "normal",
            "pending": ["d"],
            "operator": "d",
            "count": null,
            "register": null
          }
        },
        {
          "key": "w",
          "expect": {
            "mode": "normal",
            "pending": [],
            "operator": null,
            "count": null,
            "register": null
          }
        }
      ]
    },
    {
      "id": "insert-mode",
      "description": "i enters Insert mode with nothing pending.",
      "help": ["i"],
      "steps": [
        {
          "key": "i",
          "expect": {
            "mode": "insert",
            "pending": [],
            "operator": null,
            "count": null,
            "register": null
          }
        }
      ]
    }
  ]
}
