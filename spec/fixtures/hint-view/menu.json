{
  "$schema": "../../schema/fixture-hint-view.schema.json",
  "description": "The rows of the root and of its groups: entries by key, then aliases, then groups with a bound leaf below them.",
  "catalog": {
    "entries": [
      {
        "id": "file.find",
        "category": "file",
        "keys": {
          "leader": ["SPC f f", "SPC SPC"]
        },
        "label": "Find file",
        "description": "Opens a file of the workspace by its name.",
        "examples": ["SPC f f, main → main.ts opens"],
        "rationale": "f for file, f for find; SPC SPC for the most used key.",
        "stage": "stable",
        "vscode": {
          "exec": {
            "command": "workbench.action.quickOpen"
          },
          "exit": "input",
          "repeatable": false,
          "count": "none"
        },
        "intellij": {
          "action": "GotoFile"
        },
        "verifiedAgainst": {
          "vscode": "1.141.0",
          "vscodevim": "1.32.4",
          "intellij": "2026.2.3",
          "ideavim": "2.47.3"
        }
      },
      {
        "id": "search.project",
        "category": "search",
        "keys": {
          "leader": ["SPC /"]
        },
        "label": "Search in project",
        "description": "Searches the text of every file in the workspace.",
        "examples": ["SPC /, TODO → every TODO of the workspace is listed"],
        "rationale": "/ searches in Vim.",
        "stage": "stable",
        "modes": ["n", "x"],
        "aliases": [
          {
            "keys": {
              "leader": ["SPC f s"]
            },
            "until": "1.0.0"
          }
        ],
        "vscode": {
          "exec": {
            "command": "workbench.action.findInFiles"
          },
          "exit": "input",
          "repeatable": false,
          "count": "none"
        },
        "intellij": {
          "action": "FindInPath"
        },
        "verifiedAgainst": {
          "vscode": "1.141.0",
          "vscodevim": "1.32.4",
          "intellij": "2026.2.3",
          "ideavim": "2.47.3"
        }
      },
      {
        "id": "window.focus-left",
        "category": "window",
        "keys": {
          "leader": ["SPC w h"]
        },
        "label": "Focus split left",
        "description": "Moves the cursor to the split on the left.",
        "examples": ["SPC w h → the cursor is in the split on the left"],
        "rationale": "h moves left in Vim.",
        "stage": "stable",
        "vscode": {
          "exec": {
            "command": "workbench.action.focusLeftGroup"
          },
          "exit": "editor",
          "repeatable": false,
          "count": "repeat"
        },
        "intellij": {
          "ideavimKeys": "<C-w>h"
        },
        "semantics": {
          "ideavim": "Runs IdeaVim <C-w>h, which moves between editor splits."
        },
        "verifiedAgainst": {
          "vscode": "1.141.0",
          "vscodevim": "1.32.4",
          "intellij": "2026.2.3",
          "ideavim": "2.47.3"
        }
      },
      {
        "id": "window.maximize",
        "category": "window",
        "keys": {
          "leader": ["SPC w m"]
        },
        "label": "Maximize split",
        "description": "Gives the active split the whole editor area, or gives the other splits their share back.",
        "examples": ["SPC w m → the active split fills the editor area"],
        "rationale": "m for maximize.",
        "stage": "stable",
        "vscode": {
          "exec": {
            "command": "workbench.action.toggleMaximizeEditorGroup"
          },
          "exit": "editor",
          "repeatable": false,
          "count": "none"
        },
        "support": {
          "intellij": {
            "level": "none",
            "note": "This fixture binds it in VS Code only."
          }
        },
        "verifiedAgainst": {
          "vscode": "1.141.0",
          "vscodevim": "1.32.4",
          "intellij": "2026.2.3",
          "ideavim": "2.47.3"
        }
      },
      {
        "id": "git.status",
        "category": "git",
        "keys": {
          "leader": ["SPC g g"]
        },
        "label": "Show Git changes",
        "description": "Lists the changed files of the repository.",
        "examples": ["SPC g g → the changed files are listed"],
        "rationale": "g for Git, twice for its main view.",
        "stage": "experimental",
        "vscode": {
          "exec": {
            "command": "workbench.view.scm"
          },
          "exit": "input",
          "repeatable": false,
          "count": "none"
        },
        "intellij": {
          "action": "ActivateCommitToolWindow"
        },
        "verifiedAgainst": {
          "vscode": "1.141.0",
          "vscodevim": "1.32.4",
          "intellij": "2026.2.3",
          "ideavim": "2.47.3"
        }
      }
    ],
    "groups": [
      {
        "keys": "SPC f",
        "label": "File"
      },
      {
        "keys": "SPC g",
        "label": "Git"
      },
      {
        "keys": "SPC w",
        "label": "Window"
      }
    ]
  },
