{
  "name": "vim-companion-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -F @vim-companion/spec --fail-if-no-match test",
    "typecheck": "pnpm -F @vim-companion/spec --fail-if-no-match typecheck",
    "gen": "pnpm -F @vim-companion/spec --fail-if-no-match gen",
    "spec:check": "pnpm -F @vim-companion/spec --fail-if-no-match spec:check",
    "check-ids": "pnpm -F @vim-companion/spec --fail-if-no-match check-ids",
    "ids:refresh": "pnpm -F @vim-companion/spec --fail-if-no-match ids:refresh"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "lefthook": "2.2.1",
    "prettier": "3.9.10"
  }
}
