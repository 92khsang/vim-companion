# Check out every text file with LF on all platforms; Windows batch files need CRLF.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.jar binary
*.zip binary
*.vsix binary
*.ttf binary
*.woff binary
*.woff2 binary

pnpm-lock.yaml linguist-generated=true
